# Required — get a key at https://build.nvidia.com (free tier available)
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required — Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional overrides (defaults shown)
# NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# POLL_INTERVAL_SECS=10
# COOLDOWN_SECS=300

# What to attach to the Discord notification: "photo" (the frame that triggered
# detection) or "video" (a short clip recorded right after detection). Default: photo
# NOTIFY_MEDIA=photo

# Length of the video clip, in seconds, when NOTIFY_MEDIA=video. Keep this short —
# Discord webhook attachments are capped at 8MB on non-boosted servers. Default: 5
# VIDEO_DURATION_SECS=5

# Set to false to send a text-only notification with no attachment at all.
# ATTACH_MEDIA=true

# Camera device passed to ffmpeg. Defaults are:
#   Linux:   /dev/video0
#   macOS:   0                          (avfoundation device index; run
#                                        `ffmpeg -f avfoundation -list_devices true -i ""` to list)
#   Windows: video=Integrated Camera    (dshow device name; run
#                                        `ffmpeg -list_devices true -f dshow -i dummy` to list)
# CAMERA_INPUT=/dev/video0
